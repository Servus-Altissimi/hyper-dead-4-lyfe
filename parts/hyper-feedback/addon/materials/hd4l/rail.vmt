"UnlitGeneric"
{
	"$basetexture" "hd4l/rail"
	"$translucent" "1"
	"$vertexcolor" "1"
	"$vertexalpha" "1"
	"$ignorez" "1"
	"$no_fullbright" "1"
	"$nomip" "1"
	"$nolod" "1"
	"$alpha" "1"
	"$basetexturetransform" "center .5 .5 scale 1 1 rotate 0 translate 0 0"
	"Proxies"
	{
		"TextureScroll" { "texturescrollvar" "$basetexturetransform" "texturescrollrate" "0.3" "texturescrollangle" "0" }
		"Sine" { "sineperiod" "2.4" "sinemin" "0.75" "sinemax" "1.0" "resultVar" "$alpha" }
	}
}
